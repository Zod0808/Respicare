{
  "name": "respicare-web",
  "version": "1.0.1",
  "description": "RespiCare Frontend Application",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:unit": "react-scripts test --testPathPattern=__tests__ --coverage",
    "test:watch": "react-scripts test --watch",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@types/xml2js": "^0.4.14",
    "axios": "^1.12.2",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "react-scripts": "^5.0.1",
    "react-window": "^2.4.1",
    "recharts": "^3.10.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "cypress": "^16.2.0",
    "isomorphic-dompurify": "^4.6.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-junit": "^16.0.0",
    "typescript": "^4.9.5"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js"
    },
    "moduleNameMapper": {
      "^axios$": "<rootDir>/src/__mocks__/axios.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^entities/decode$": "<rootDir>/node_modules/entities/dist/decode.js",
      "^entities/escape$": "<rootDir>/node_modules/entities/dist/escape.js",
      "^css-tree/utils$": "<rootDir>/node_modules/css-tree/cjs/utils/index.cjs",
      "^css-tree/convertor$": "<rootDir>/node_modules/css-tree/cjs/convertor/index.cjs",
      "^css-tree/generator$": "<rootDir>/node_modules/css-tree/cjs/generator/index.cjs",
      "^css-tree/selector-parser$": "<rootDir>/node_modules/css-tree/cjs/parser/parse-selector.cjs",
      "^css-tree/walker$": "<rootDir>/node_modules/css-tree/cjs/walker/index.cjs"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(@exodus|entities|@asamuzakjp|@csstools|@adobe[/\\\\]css-tools|@bramus[/\\\\]specificity|parse5)[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "resetMocks": false,
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/tests/**",
      "!src/**/*.test.{js,jsx,ts,tsx}",
      "!src/**/*.spec.{js,jsx,ts,tsx}",
      "!src/reportWebVitals.js",
      "!src/setupTests.js",
      "!src/App.js",
      "!src/index.js",
      "!src/serviceWorkerRegistration.js",
      "!src/contexts/I18nContext.js",
      "!src/components/AutomaticReportsDashboard.js",
      "!src/components/FairnessVisualization.js",
      "!src/components/MLAdvancedResults.js",
      "!src/components/Navbar.js",
      "!src/components/ReferralManagement.js",
      "!src/pages/AdminPage.js",
      "!src/pages/LoginPage.js",
      "!src/pages/PatientMonitoringPage.js",
      "!src/pages/RegisterPage.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "lines": 80,
        "functions": 75,
        "branches": 65
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:3001",
  "overrides": {
    "braces": ">=3.0.3",
    "form-data": ">=2.5.4",
    "node-notifier": ">=8.0.1",
    "tough-cookie": ">=4.1.3",
    "nth-check": ">=2.0.1",
    "postcss": ">=8.5.18 <9.0.0",
    "micromatch": ">=4.0.8",
    "typescript": "^4.9.5",
    "yaml": "2.8.1",
    "websocket-driver": ">=0.7.5",
    "body-parser": ">=1.20.9 <2.0.0",
    "node-forge": ">=1.4.0 <2.0.0",
    "nanoid": ">=3.3.18 <4.0.0",
    "browserslist": ">=4.28.7 <5.0.0",
    "tmp": ">=0.2.6 <1.0.0",
    "@babel/plugin-transform-modules-systemjs": ">=7.29.4 <8.0.0",
    "path-to-regexp": ">=0.1.13 <0.2.0",
    "flatted": ">=3.4.2 <4.0.0",
    "underscore": ">=1.13.8 <2.0.0",
    "jsonpath": ">=1.3.0 <2.0.0",
    "rollup": ">=2.80.0 <3.0.0",
    "react-scripts": {
      "minimatch": ">=3.1.4 <4.0.0"
    },
    "webpack-dev-server": {
      "ws": ">=8.21.0"
    },
    "picomatch": ">=2.3.2 <3.0.0",
    "postcss-svgo": {
      "svgo": ">=2.8.1 <3.0.0"
    },
    "jsdom": {
      "ws": ">=7.5.11 <8.0.0"
    },
    "tinyglobby": {
      "picomatch": ">=4.0.4 <5.0.0"
    },
    "filelist": {
      "minimatch": ">=5.1.8 <6.0.0"
    }
  }
}
